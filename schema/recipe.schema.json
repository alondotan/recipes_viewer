{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "recipe.schema.json",
  "title": "Recipe",
  "description": "מתכון אחד לקובץ. בדיקות שאי אפשר לבטא כאן (ref שמפנה למרכיב קיים, id כפול, maxMinutes >= minutes, maxAmount >= amount, maxValue >= value, maxServings >= servings) נעשות ב-js/validate.js.",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "ingredients"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1, "description": "מזהה יציב. משמש לזיהוי המתכון בשמירת ההתקדמות; ברירת מחדל: title" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "author": { "type": "string", "description": "של מי המתכון, למשל: יעל. בנפרד מ-source" },
    "servings": { "type": "number", "exclusiveMinimum": 0 },
    "maxServings": { "$ref": "#/$defs/positive", "description": "לטווח, למשל 8-10 מנות. דורש servings" },
    "totalTime": { "$ref": "#/$defs/duration", "description": "זמן כולל מההתחלה ועד ההגשה, כולל המתנות. אם חסר, האתר מחשב מזמני השלבים" },
    "activeTime": { "$ref": "#/$defs/duration", "description": "זמן עבודה בפועל" },
    "difficulty": { "enum": ["קל", "בינוני", "קשה"] },
    "kashrut": { "enum": ["בשרי", "חלבי", "פרווה"] },
    "yield": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "unit"],
      "description": "כמה יוצא כשלא מדובר במנות, למשל 15 יחידות מיני",
      "properties": {
        "amount": { "$ref": "#/$defs/positive" },
        "maxAmount": { "$ref": "#/$defs/positive", "description": "לטווח, למשל 12-15 קציצות" },
        "unit": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "category": { "enum": ["מנה עיקרית", "תוספת", "סלט", "מרק", "מאפה", "לחם", "קינוח", "חטיף", "ממרח", "רוטב", "שתייה"], "description": "סוג המנה. משמש לסינון" },
    "cuisine": { "enum": ["ישראלי", "מזרח תיכוני", "אסייתי", "איטלקי", "צרפתי", "יווני", "אמריקאי", "מקסיקני", "בינלאומי"], "description": "סגנון המטבח. משמש לסינון" },
    "mainIngredients": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" }, "maxItems": 5, "description": "עד 5 מרכיבים מרכזיים, בשם כללי (למשל: טופו, עדשים). משמש לחיפוש" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "source": { "type": "string", "description": "קישור או שם המקור" },
    "image": { "type": "string", "description": "נתיב או URL לתמונה" },
    "notes": { "type": "array", "items": { "type": "string" }, "description": "הערות על המתכון כולו, למשל הצעת הגשה" },
    "equipment": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" }, "description": "ציוד מיוחד, למשל: תבנית 24x36 ס\"מ, מעבד מזון" },
    "ingredients": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/ingredient" }
    },
    "steps": {
      "type": "array",
      "items": { "$ref": "#/$defs/step" },
      "description": "אפשר להשמיט, למשל ברוטב שכל ההכנה שלו היא ערבוב"
    },
    "fullText": { "type": "string", "description": "הטקסט המקורי. אם חסר, האתר מייצר טקסט מהמרכיבים והשלבים" }
  },
  "$defs": {
    "positive": { "type": "number", "exclusiveMinimum": 0 },
    "nonEmpty": { "type": "string", "minLength": 1 },

    "duration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minutes"],
      "properties": {
        "minutes": { "$ref": "#/$defs/positive" },
        "maxMinutes": { "$ref": "#/$defs/positive", "description": "לטווח, למשל שעה-שעה וחצי" }
      }
    },

    "ingredient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmpty", "description": "מזהה ייחודי שהשלבים מפנים אליו" },
        "name": { "$ref": "#/$defs/nonEmpty" },
        "amount": { "$ref": "#/$defs/positive" },
        "maxAmount": { "$ref": "#/$defs/positive", "description": "לטווח, למשל 2-3 כפות. דורש amount" },
        "unit": { "type": "string" },
        "note": { "type": "string", "description": "למשל: קצוץ דק" },
        "group": { "type": "string", "description": "כותרת קבוצה, למשל: לבצק, תבלינים" },
        "optional": { "type": "boolean" },
        "alternatives": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" }, "description": "תחליפים, למשל: מים, חלב סויה" }
      }
    },

    "ingredientRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref"],
      "properties": {
        "ref": { "$ref": "#/$defs/nonEmpty", "description": "id של מרכיב מתוך ingredients" },
        "amount": { "$ref": "#/$defs/positive", "description": "דריסת כמות כשהשלב משתמש רק בחלק" },
        "maxAmount": { "$ref": "#/$defs/positive", "description": "לטווח. דורש amount" },
        "unit": { "type": "string" },
        "note": { "type": "string" }
      }
    },

    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minutes"],
      "properties": {
        "minutes": { "$ref": "#/$defs/positive" },
        "maxMinutes": { "$ref": "#/$defs/positive", "description": "לטווח, למשל 8-10 דקות. זמנים של יום ומעלה מוצגים בימים, ולא נוצר להם טיימר אוטומטי" },
        "type": { "enum": ["active", "passive"], "description": "active = עובדים, passive = מחכים" }
      }
    },

    "timer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minutes"],
      "properties": {
        "label": { "type": "string", "description": "ברירת מחדל: כותרת השלב" },
        "minutes": { "$ref": "#/$defs/positive" }
      }
    },

    "temperature": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [{ "required": ["value"] }, { "required": ["note"] }],
      "properties": {
        "value": { "type": "number" },
        "maxValue": { "type": "number", "description": "לטווח, למשל 170-180. דורש value" },
        "unit": { "enum": ["C", "F"], "default": "C" },
        "note": { "type": "string", "description": "למשל: טורבו, חום עליון-תחתון. בלי value: תיאור החום, למשל: חום גבוה" }
      }
    },

    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instruction"],
      "properties": {
        "id": { "type": ["number", "string"] },
        "group": { "type": "string", "description": "חלק במתכון, למשל: לשכבת הטראפלס. שלבים רצופים עם אותו group מוצגים יחד" },
        "method": { "type": "string", "description": "שיטת הכנה חלופית, למשל: בתנור / בטיגון. שלבים עם method שונה הם חלופות, ומבצעים רק אחת מהן. שלבים בלי method משותפים לכל השיטות" },
        "title": { "type": "string" },
        "instruction": { "$ref": "#/$defs/nonEmpty" },
        "ingredients": { "type": "array", "items": { "$ref": "#/$defs/ingredientRef" } },
        "time": { "$ref": "#/$defs/time" },
        "timers": {
          "type": "array",
          "items": { "$ref": "#/$defs/timer" },
          "description": "אם חסר ויש time, נוצר טיימר אחד לפי time.minutes"
        },
        "heat": { "type": "string", "description": "עוצמת אש, למשל: בינונית" },
        "temperature": { "$ref": "#/$defs/temperature" },
        "doneWhen": { "type": "string", "description": "סימן שהשלב הסתיים, למשל: קיסם שננעץ במרכז יוצא נקי" },
        "tips": { "type": "array", "items": { "type": "string" } },
        "warning": { "type": "string" }
      }
    }
  }
}
