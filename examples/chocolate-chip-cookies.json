{
  "$schema": "../schema/recipe.schema.json",
  "schemaVersion": 1,
  "id": "chocolate-chip-cookies",
  "title": "עוגיות שוקולד צ'יפס",
  "description": "עוגיות רכות מבפנים ופריכות בשוליים",
  "servings": 24,
  "tags": ["אפייה", "מתוק"],

  "ingredients": [
    { "id": "butter",      "name": "חמאה",          "amount": 200,  "unit": "גרם",  "note": "בטמפרטורת החדר", "group": "רטובים" },
    { "id": "brown-sugar", "name": "סוכר חום",      "amount": 150,  "unit": "גרם",  "group": "רטובים" },
    { "id": "sugar",       "name": "סוכר לבן",      "amount": 50,   "unit": "גרם",  "group": "רטובים" },
    { "id": "egg",         "name": "ביצה",          "amount": 1,    "unit": "יחידה", "group": "רטובים" },
    { "id": "vanilla",     "name": "תמצית וניל",    "amount": 1,    "unit": "כפית", "group": "רטובים" },
    { "id": "flour",       "name": "קמח לבן",       "amount": 280,  "unit": "גרם",  "group": "יבשים" },
    { "id": "soda",        "name": "סודה לשתייה",   "amount": 1,    "unit": "כפית", "group": "יבשים" },
    { "id": "salt",        "name": "מלח",           "amount": 0.5,  "unit": "כפית", "group": "יבשים" },
    { "id": "chips",       "name": "שוקולד צ'יפס",  "amount": 200,  "unit": "גרם" }
  ],

  "steps": [
    {
      "title": "הקצפה",
      "instruction": "מקציפים את החמאה עם שני סוגי הסוכר עד לתערובת בהירה ואוורירית.",
      "ingredients": [{ "ref": "butter" }, { "ref": "brown-sugar" }, { "ref": "sugar" }],
      "time": { "minutes": 3, "type": "active" }
    },
    {
      "title": "ביצה ווניל",
      "instruction": "מוסיפים את הביצה ואת הווניל ומקציפים עד שהתערובת אחידה.",
      "ingredients": [{ "ref": "egg" }, { "ref": "vanilla" }],
      "time": { "minutes": 1, "type": "active" }
    },
    {
      "title": "יבשים",
      "instruction": "מוסיפים קמח, סודה לשתייה ומלח ומערבבים במהירות נמוכה רק עד שאין קמח יבש.",
      "ingredients": [{ "ref": "flour" }, { "ref": "soda" }, { "ref": "salt" }],
      "time": { "minutes": 1, "type": "active" },
      "warning": "לא לערבב יותר מדי, העוגיות ייצאו קשות."
    },
    {
      "title": "שוקולד וקירור",
      "instruction": "מקפלים פנימה את רוב השוקולד צ'יפס, מכסים ומכניסים את הבצק למקרר.",
      "ingredients": [{ "ref": "chips", "amount": 180 }],
      "time": { "minutes": 30, "type": "passive" },
      "timers": [{ "label": "קירור בצק", "minutes": 30 }],
      "tips": ["אפשר לקרר גם לילה שלם. הטעם רק משתפר."]
    },
    {
      "title": "חימום תנור",
      "instruction": "כ-15 דקות לפני סוף הקירור מחממים את התנור ומרפדים 2 תבניות בנייר אפייה.",
      "temperature": { "value": 180, "note": "חום עליון-תחתון" },
      "time": { "minutes": 15, "type": "passive" },
      "timers": [{ "label": "חימום תנור", "minutes": 15 }]
    },
    {
      "title": "יצירת כדורים",
      "instruction": "יוצרים כדורים בגודל אגוז מלך, מסדרים בתבנית במרווחים ולוחצים מעל את שאר השוקולד צ'יפס.",
      "ingredients": [{ "ref": "chips", "amount": 20, "note": "לקישוט מעל" }],
      "time": { "minutes": 10, "type": "active" }
    },
    {
      "title": "אפייה",
      "instruction": "אופים עד שהשוליים מזהיבים והמרכז עדיין נראה רך.",
      "temperature": { "value": 180 },
      "time": { "minutes": 10, "maxMinutes": 12, "type": "passive" },
      "timers": [
        { "label": "תבנית 1", "minutes": 11 },
        { "label": "תבנית 2", "minutes": 11 }
      ],
      "tips": ["העוגיות מתקשות בזמן ההתקררות. אל תחכו שייראו מוכנות בתנור."]
    },
    {
      "title": "קירור",
      "instruction": "משאירים 5 דקות על התבנית ומעבירים לרשת עד שמתקררות לגמרי.",
      "time": { "minutes": 5, "type": "passive" }
    }
  ]
}
